# Copy to infra/docker/.env (git-ignored) and set real values before running docker-compose.yml.
# Never commit the real .env. Rotate any value that was ever committed to git history.
POSTGRES_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
# Pin a released n8n tag from https://hub.docker.com/r/n8nio/n8n/tags (do not use "latest").
N8N_VERSION=pin-me
